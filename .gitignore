# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 虚拟环境
.venv/
.venv-verify/
venv/

# 环境配置（含本地密钥/地址，.env.example 除外）
.env

# K8s 部署密钥（从 secret.example.yaml 复制填写；含明文口令，禁止提交）
deploy/k8s/secret.yaml

# 前端依赖与缓存（web/dist 保留以便 BFF 开箱即用）
web/node_modules/
web/.vite/

# 运行产物（索引 / 沙箱 / 留痕 / 审计 / 验证截图）
# 注：用 data/* 而非 data/ —— 目录级排除后无法再重新包含内部子路径
# （gitignore 限制），data/* 允许下列评测资产白名单生效
data/*

# 评测夹具与样本（P1-5 测试资产，纳入版本控制；其 __pycache__ 仍排除）
!data/fix_eval_repo/
!data/fix_eval_repo/**
data/fix_eval_repo/**/__pycache__/
!data/fix_eval_samples.json
!data/fix_eval_report.json
!data/triage_eval_samples.json
!data/triage_eval_report.json

# 运行日志
*.log
nohup.out

# 系统文件
.DS_Store
