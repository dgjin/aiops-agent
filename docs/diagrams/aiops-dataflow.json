  "cards": [
    {
      "dot": "emerald",
      "title": "主数据路径",
      "items": [
        "告警与日志链在证据包汇合 → 根因判定 → 补丁生成 → 沙箱验证 → 审批放行",
        "流标签命名数据资产（证据包 / 根因报告 / 候选补丁），而非传输原语",
        "旁路检测器与 Prometheus 规则共用告警入口，Token 鉴权 fail-closed"
      ]
    },
    {
      "dot": "rose",
      "title": "三道闸门",
      "items": [
        "闸门 1：置信度 < 0.8 → ESCALATED，不进入修复链",
        "闸门 2：飞书卡片回调直达；FIFO + 超时驳回；保护目录二级审批",
        "闸门 3：公告窗口 + 金丝雀劣化回滚；kill switch 一键停自动"
      ]
    },
    {
      "dot": "orange",
      "title": "需求链与留痕",
      "items": [
        "需求：导出 API 30s 同步；BFF（RAG + LLM）输出方案 / 验收 / 疑点",
        "管理员批准（版本冻结）→ 批准版方案即根因，跳过诊断直入修复链",
        "JSONL 全量留痕（actor + 时间戳）；watchdog 判活 6 组件；控制台 RBAC 消费"
      ]
    }
  ]
