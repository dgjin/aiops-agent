# AIOps 环境变量配置（复制为 .env 后按需修改；.env 会被自动加载）
# 分组：【必需】= 跑通演示通常要确认；【演示】= 演示常用；【生产】= 接真实系统时配置。
# 说明：代码中均有默认值，.env 仅在需要覆盖默认值时填写。

# ---------- 【必需】策略与基础设施 ----------
# 策略文件路径（演示用 demo-policy.yaml 加速；生产用 release-gate-policy.yaml）
# worker / BFF / demo_cli 必须使用同一份，否则策略快照错配。
AIOPS_POLICY_PATH=./demo-policy.yaml

# Temporal gRPC 地址（worker / BFF / demo_cli 连接）
TEMPORAL_ADDRESS=localhost:7233

# Loki 地址（日志证据来源；注意本栈映射在 3101，避开 Grafana 的 3100）
AIOPS_LOKI_URL=http://localhost:3101

# Ollama 地址（本地 LLM：triage 根因 + fix 修复）
AIOPS_OLLAMA_URL=http://localhost:11434

# ---------- 【演示】模型与后端 ----------
# 根因分析模型（默认 qwen3:8b）
# AIOPS_TRIAGE_MODEL=qwen3:8b
# 修复生成模型（默认复用 triage 模型；可换更大模型提升 diff 正确率，如 qwen3.8:27b-mlx）
# AIOPS_FIX_MODEL=qwen3:8b
# 向量检索后端：auto / faiss / python（默认 auto，有 faiss 用 faiss）
# AIOPS_VECTOR_BACKEND=auto
# 嵌入模型（默认见 code_rag.py）
# AIOPS_EMBED_MODEL=

# ---------- 【演示】稳定版服务探测 ----------
# 稳定版容器名与端口（系统状态页 / 发布结果展示用）
AIOPS_STABLE_CONTAINER=aiops-stable-order
AIOPS_STABLE_PORT=18080

# ---------- 【生产】沙箱与发布 ----------
# 沙箱测试镜像（默认 python:3.12-slim）
# AIOPS_SANDBOX_IMAGE=python:3.12-slim
# 金丝雀镜像名前缀
# AIOPS_CANARY_IMAGE_PREFIX=aiops-demo-app
# ArgoCD 接入（留空则 recorded 留痕到 data/argocd/）
# AIOPS_ARGOCD_URL=
# AIOPS_ARGOCD_TOKEN=

# ---------- 【生产】通知与告警 ----------
# 通知提供者：feishu / dingtalk（留空则 recorded 留痕到 data/notify/）
# AIOPS_NOTIFY_PROVIDER=
# AIOPS_NOTIFY_SECRET=
# AIOPS_NOTIFY_CALLBACK_BASE=
# 告警 Webhook 监听端口（默认 8099）
# AIOPS_WEBHOOK_PORT=8099
