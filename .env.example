# AIOps 环境变量配置（复制为 .env 后按需修改；.env 会被自动加载）
# 分组：【模式】= 运行模式与持久化；【必需】= 跑通演示通常要确认；【演示】= 演示常用；【生产】= 接真实系统时配置。
# 说明：代码中均有默认值，.env 仅在需要覆盖默认值时填写。

# ---------- 【模式】运行模式与持久化 ----------
# production（默认）：启用 MySQL 持久化（审计 / 令牌 / 清单 / 流程速查 / kill switch），
#                     未配置 AIOPS_DATABASE_URL 时启动即报错（fail-fast，防静默丢数据）；
# demo：零外部依赖的文件后端（JSON / JSONL），与生产数据互不影响，可随时启动。
# 演示/本地开发必须显式设置 demo；scripts/demo-up.sh 会自动导出。
AIOPS_MODE=demo
# 生产数据库连接串（MySQL 8.0；驱动前缀固定 mysql+pymysql；密码请经密钥管理注入，勿提交）
# 端口说明：本机 compose 起的 MySQL 映射在 3316（docker compose --profile prod up -d mysql），
#           避开宿主机常见 3306；K8s / 云 RDS 环境按实际地址端口填写。
# AIOPS_DATABASE_URL=mysql+pymysql://aiops:<password>@127.0.0.1:3316/aiops?charset=utf8mb4
# 数据根目录（可选：显式覆盖模式默认——demo=data/，production=data/prod/）
# AIOPS_DATA_ROOT=/var/lib/aiops

# ---------- 【必需】策略与基础设施 ----------
# 策略文件路径（演示用 demo-policy.yaml 加速；生产用 release-gate-policy.yaml）
# worker / BFF / demo_cli 必须使用同一份，否则策略快照错配。
AIOPS_POLICY_PATH=./demo-policy.yaml

# ---------- 【必需】控制台鉴权（fail-closed：未配置则拒绝所有 /api 请求） ----------
# Bearer Token 注册表：token → {user, role}；role ∈ viewer | operator | admin
#   viewer    读接口
#   operator  + 审批 / 发布指令 / 排队补丁
#   admin     + 被监控应用 CRUD（后续配置项维护）
# 请求需带 Authorization: Bearer <token>；控制台左下角「访问令牌」可设置。
# 注意：这是 JSON，需用单引号包裹整串（.env 语法）。
AIOPS_CONSOLE_AUTH_TOKENS='{"tok-view":{"user":"viewer01","role":"viewer"},"tok-ops":{"user":"zhang","role":"operator"},"tok-adm":{"user":"li","role":"admin"}}'
# 上式仅作**首次播种**：运行期注册表在下面的文件里（权限 600，含明文令牌，勿提交）。
# 自动轮换：到期即为每个身份生成新令牌；旧令牌转 previous 并在宽限期内继续有效，
# 因此轮换不会把在用的运维锁在门外。间隔设 0 表示关闭自动轮换。
# AIOPS_CONSOLE_TOKEN_FILE=data/console_tokens.json
# AIOPS_TOKEN_ROTATE_INTERVAL_SECONDS=2592000   # 30 天
# AIOPS_TOKEN_ROTATE_INTERVAL_SECONDS=0         # 0 = 关闭自动轮换：令牌固定为上表播种值，不失效
# AIOPS_TOKEN_GRACE_SECONDS=604800              # 7 天
# 到期检查周期（秒，默认 300；仅调试时调小）
# AIOPS_TOKEN_ROTATE_CHECK_SECONDS=300
# 是否允许经接口回显令牌值（默认 false：令牌只落在 600 权限的注册表文件里）
# AIOPS_TOKEN_ALLOW_REVEAL=false

# Temporal gRPC 地址（worker / BFF / demo_cli 连接）
TEMPORAL_ADDRESS=localhost:7233

# Loki 地址（日志证据来源；注意本栈映射在 3101，避开 Grafana 的 3100）
AIOPS_LOKI_URL=http://localhost:3101

# Ollama 地址（本地 LLM：triage 根因 + fix 修复）
AIOPS_OLLAMA_URL=http://localhost:11434

# ---------- 【演示】模型与后端 ----------
# 根因分析模型（默认 qwen3:8b）
# AIOPS_TRIAGE_MODEL=qwen3:8b
# 修复生成模型（默认复用 triage 模型；可换更大模型提升 diff 正确率，如 qwen3.8:27b-mlx）
# AIOPS_FIX_MODEL=qwen3:8b

# ---------- 【可选】Qoder 修复引擎（AIOPS_FIX_PROVIDER=qoder 时启用） ----------
# 设计见《AIOps 自动运维智能体系统 Qoder 修复引擎接入设计》。
# 修复提供者：ollama（默认，本地 LLM）/ qoder（Qoder CLI 无头调用，隔离工作区自主修复）
# AIOPS_FIX_PROVIDER=ollama
# Qoder CLI 安装：curl -fsSL https://qoder.com/install | bash   （验证：qoder --version）
# CI/无人值守鉴权：PAT 取自 https://qoder.com/account/integrations
# AIOPS_QODER_TOKEN=
# QODER_PERSONAL_ACCESS_TOKEN=
# AIOPS_QODER_BIN=qoder
# 修复模型（默认 DeepSeek-Flash）。注意 Qoder 模型 ID **区分大小写**：写错（如小写 deepseek-flash）
# 不会报错，CLI 会静默回退 auto——接入层会把该警告写入 meta.model_warning 与运行留痕。
# 可选值用 `qodercli --list-models` 查看（如 Auto/DeepSeek-Flash/Qwen3.8-Max/Kimi-K3/GLM-5.3）。
# AIOPS_QODER_MODEL=DeepSeek-Flash
# AIOPS_QODER_TIMEOUT=180
# AIOPS_QODER_MAX_TURNS=20
# AIOPS_QODER_PERMISSION_MODE=accept_edits
# AIOPS_QODER_ALLOWED_TOOLS=Read,Edit,Write,Grep,Glob
# 隔离工作区根目录（注意：沙箱工作区须位于容器可挂载路径，colima 默认仅挂载 $HOME）
# AIOPS_QODER_ROOT=./data/qoder
# 向量检索后端：auto / faiss / python（默认 auto，有 faiss 用 faiss）
# AIOPS_VECTOR_BACKEND=auto
# 嵌入模型（默认见 code_rag.py）
# AIOPS_EMBED_MODEL=

# ---------- 【演示】被监控应用 ----------
# 被监控应用的根地址（控制台「系统状态 → 被监控应用」探测展示用；默认 http://localhost:3000/）
# 探测语义：能收到任何 HTTP 响应（含 4xx/5xx）即视为在线；仅连接失败/超时判定不可达。
AIOPS_MONITOR_URL=http://localhost:3000/
# 被监控应用在 Loki 中的 service 标签（ship_app_logs.py 采集时写入，供 query_lines 查询）
# AIOPS_MONITOR_SERVICE=nl2sql
# 首次播种时的日志路径（之后请在控制台「被监控应用」里维护，采集器会热读取清单）
# AIOPS_MONITOR_LOG_PATH=
# Code RAG 索引路径（默认 data/code_index.json；指向被监控应用的独立索引即可切换检索语料）
# AIOPS_CODE_INDEX=data/code_index_nl2sql.json
# 嵌入批大小（大仓库分批请求，默认 64）
# AIOPS_EMBED_BATCH_SIZE=64

# ---------- 【演示】稳定版服务探测 ----------
# 稳定版容器名与端口（系统状态页 / 发布结果展示用）
AIOPS_STABLE_CONTAINER=aiops-stable-order
AIOPS_STABLE_PORT=18080

# ---------- 【生产】沙箱与发布 ----------
# 沙箱测试镜像（默认 python:3.12-slim）
# AIOPS_SANDBOX_IMAGE=python:3.12-slim
# 金丝雀镜像名前缀
# AIOPS_CANARY_IMAGE_PREFIX=aiops-demo-app
# ArgoCD 接入（留空则 recorded 留痕到 data/argocd/）
# AIOPS_ARGOCD_URL=
# AIOPS_ARGOCD_TOKEN=

# ---------- 【生产】通知与告警 ----------
# 通知提供者：feishu / dingtalk（留空则 recorded 留痕到 data/notify/）
# AIOPS_NOTIFY_PROVIDER=
# AIOPS_NOTIFY_SECRET=
# AIOPS_NOTIFY_CALLBACK_BASE=
# 告警 Webhook 监听端口（默认 8099）
# AIOPS_WEBHOOK_PORT=8099

# ---------- 【生产】Git 平台接入（MR 真实创建，P5-01） ----------
# 启用方式：策略文件（release-gate-policy.yaml）增加 git 段：
#   git:
#     repo_url: "https://gitlab.example.com/ops/demo-app"   # 支持 GitLab / GitHub / Gitee
#     token_secret: "aiops-git-token"                        # K8s Secret 名称（部署侧引用）
#     default_branch: "main"
#     mr_labels: [aiops, auto-fix]
# 令牌运行时经本环境变量注入（对应 token_secret 所指 Secret）；未配置时 MR 活动返回
# recorded 桩（演示行为不变），调用失败降级 degraded 且流程继续进入人工审批。
# AIOPS_GIT_TOKEN=

# ---------- 【生产】数据清理（TTL，P5-03） ----------
# 保留期随模式内置（见 aiops_agent/cleanup.py）：
#   production：审计/流程记录 365 天、沙箱/Qoder 7 天、通知/ArgoCD 90 天
#   demo：审计/流程记录 30 天、沙箱/Qoder 1 天、通知/ArgoCD 7 天
# 执行：python -m aiops_agent.cleanup（生产 CronJob；--dry-run 预演）或 demo_cli.py cleanup。
# Temporal 历史保留（30 天）由 Temporal namespace retention 配置（部署侧）。

# ---------- 【生产】速率限制与安全头 ----------
# BFF 速率限制：token / IP 双维度滑动窗口。默认 production=开、demo=关；
# 显式设置 1/0 可覆盖（演示环境如需验证限速行为可设 1）。
# AIOPS_RATE_LIMIT_ENABLED=1
# 已认证读配额（次/分钟，默认 240：控制台多标签轮询实测所需）
# AIOPS_RATE_LIMIT_READ_PER_MIN=240
# 已认证写配额（次/分钟，默认 20）
# AIOPS_RATE_LIMIT_WRITE_PER_MIN=20
# 认证失败按 IP 配额（次/分钟，默认 10；防令牌暴力破解，超限返回 429）
# AIOPS_RATE_LIMIT_AUTH_FAIL_PER_MIN=10
# Redis（可选）：配置后限速窗口存 Redis（多副本部署共享配额）；不配则用进程内窗口。
# 端口说明：本机 compose 起的 Redis 映射在 6380，避开宿主机常见 6379。
# AIOPS_REDIS_URL=redis://127.0.0.1:6380/0
# 安全响应头（CSP / X-Frame-Options / nosniff 等）恒开启；HSTS 仅在 HTTPS（或
# X-Forwarded-Proto: https，即 TLS 终结代理）时下发，无需配置。

# ---------- 【生产】可观测性（Prometheus / OpenTelemetry） ----------
# Prometheus 指标：BFF 暴露 GET /metrics（无鉴权，生产以 NetworkPolicy / Ingress 白名单限制）；
# worker 独立指标服务端口（默认 9090；设 0 关闭）
# AIOPS_METRICS_PORT=9090
# OpenTelemetry 追踪（可选）：配置 OTLP HTTP 端点（如 http://localhost:4318）后，
# BFF HTTP 请求与 worker 的 workflow/activity 自动创建 span；不配则完全 no-op
# AIOPS_OTEL_ENDPOINT=http://localhost:4318
